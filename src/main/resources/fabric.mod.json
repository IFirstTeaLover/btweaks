{
	"schemaVersion": 1,
	"id": "btweaks",
	"version": "${version}",
	"name": "btweaks",
	"description": "Bulba's Tweaks!",
	"authors": [
		"BSprout"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/btweaks",
		"sources": "https://github.com/ifirsttealover/btweaks"
	},
	"license": "MIT",
	"icon": "assets/btweaks/icon.png",
